{
  "grammars": [
    {
      "name": "tlc",
      "camelcase": "Tlc",
      "scope": "source.tlc",
      "path": ".",
      "file-types": ["tlc"],
      "injection-regex": "^tlc$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for TLC",
    "links": {
      "repository": "https://github.com/westcoastcode-se/tlc-tree-sitter"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
